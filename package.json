{
  "name": "wotr-planner",
  "version": "0.0.0",
  "description": "A Pathfinder: Wrath of the Righteous build planner and an MCP server for agents",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "start": "bun dist/server/node.js",
    "serve": "bun --bun vite preview",
    "test": "vitest",
    "lint": "bun --bun oxlint src engine tools vite",
    "typecheck": "bun --bun tsc --noEmit -p .",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "import": "bun tools/importer/main.ts",
    "engine-run": "bun --tsconfig-override=tsconfig.json",
    "check:repo": "bun tools/repo-checks/main.ts",
    "census": "bun tools/importer/census.ts",
    "show": "bun tools/dump/show.mjs",
    "mcp-stdio": "bun src/mcp-server/stdio.ts",
    "check": "bun run format:check && bun run lint && bun run check:repo && bun run typecheck && bun run import -- --check && vitest run --project engine && vitest run --project client --project server"
  },
  "license": "MIT",
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0",
    "@solidjs/start-devtools": "^1.0.0-next.4",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.20.0",
    "filesystem-routing": "0.5.0",
    "jsdom": "^31.0.0",
    "oxc-parser": "0.139.0",
    "oxfmt": "0.76.0",
    "oxlint": "~1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remix-run/cookie": "^1.0.2",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0",
    "valibot": "^1.4.2"
  }
}
