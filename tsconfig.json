{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // vite.config.ts imports its local plugin with the .ts extension, as Vite's native config loader requires.
    "allowImportingTsExtensions": true,
    "paths": {
      // The rules engine at the repo root (ticket 16's amendment).
      "~engine/*": ["./engine/*"]
    },

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  }
}
